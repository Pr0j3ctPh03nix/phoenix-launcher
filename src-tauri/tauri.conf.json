{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phoenix Launcher",
  "version": "1.0.0",
  "identifier": "com.projectphoenix.launcher",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Phoenix Launcher",
        "width": 750,
        "height": 700,
        "minWidth": 560,
        "minHeight": 540,
        "resizable": true,
        "theme": "Dark",
        "visible": false,
        "backgroundColor": "#0f0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
