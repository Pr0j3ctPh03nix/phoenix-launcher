# Rust / Tauri build output. Both roots: cargo's default lands under src-tauri/, and a build run
# with CARGO_TARGET_DIR pointed at the repo root (worktree builds do this) lands here.
/src-tauri/target/
/target/
/src-tauri/gen/

# Node
/node_modules/

# Generated decoy game folder for local testing (see dev/make_decoy.sh)
/dev/decoy_game/

# Headless frontend screenshots + their working copy (see dev/shoot.sh)
/dev/preview/.out/

# Pr0j3ctPh03nix/release-tooling, checked out at `v1` by both workflows (and by hand for a local
# build — src-tauri/build.rs reads the release keys from .tooling/keys). It has its own repo;
# a copy committed here would be exactly the drifting vendored copy this replaced.
/.tooling/

# What a release attaches: the exe, its .sha256 and the seal request built from them (release.yml).
# A local run of dev/gen_launcher_manifest.py lands here too.
/staging/

# Bytecode from running that tooling — written whenever CI, or a local dry run, imports one of
# those scripts from inside this tree.
__pycache__/
*.pyc

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Internal dev docs — kept LOCAL, never shipped in the public updater repo.
# CLAUDE.md / known_bugs.md are AI + dev context; CHANGELOG.md is deleted for good —
# changelogs live in the GitHub Release sections (annotated-tag bodies), not a tracked file.
/CLAUDE.md
/known_bugs.md
/CHANGELOG.md
